# Publish only the standalone PresentCoach package surface.
/src/presentcoach/*.py
!/src/presentcoach/__init__.py
!/src/presentcoach/local_camera.py
!/src/presentcoach/landmarks.py
!/src/presentcoach/presentation_*.py
/tests/*
!/tests/test_presentation_*.py
!/tests/test_presentcoach_e2e_report.py
/scripts/*
!/scripts/setup_presentcoach.sh
!/scripts/install_presentcoach_app.sh
!/scripts/evaluate_presentcoach_e2e.py
!/scripts/evaluate_presentcoach_llm.py
!/scripts/download_test_videos.sh
!/scripts/evaluate_presentcoach_videos.py
!/scripts/evaluate_face_tracking.py
!/scripts/evaluate_dynamic_presentations.py
/models/*
!/models/PresentCoach.Modelfile
/reports/*
!/reports/presentcoach_llm_eval.json
!/reports/presentcoach_e2e_development.json
!/reports/presentcoach_e2e_holdout.json
!/reports/presentcoach_video_eval.json
!/reports/presentcoach_tracking_eval.json
!/reports/presentcoach_dynamic_development.json
!/reports/presentcoach_dynamic_holdout.json
!/reports/presentcoach_dynamic_iteration1_development.json
!/reports/presentcoach_dynamic_iteration1_holdout.json
/macos/*
