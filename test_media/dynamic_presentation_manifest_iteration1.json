{
  "schema_version": 1,
  "description": "Frozen, identity-free corpus of real moving-speaker presentation excerpts for PresentCoach measurement and grounded-feedback evaluation.",
  "target_fps": 15,
  "model": {
    "filename": "face_landmarker.task",
    "sha256": "64184e229b263107bc2b804c6625db1341ff2bb731874b0bcc2fe6544e0bc9ff"
  },
  "evaluation_only": true,
  "never_training_data": true,
  "identity_recognition": false,
  "face_embeddings_allowed": false,
  "landmarks_persisted": false,
  "gaze_ground_truth_available": false,
  "gaze_annotation_policy": "unknown_for_every_manual_interval",
  "binary_distribution": "Video binaries are downloaded locally and excluded from Git; source licenses remain controlling.",
  "canonical_excerpt": {
    "container": "MP4",
    "video_codec": "H.264 via libx264",
    "width": 854,
    "height": 480,
    "frame_rate": 30,
    "pixel_format": "yuv420p",
    "audio_codec": "AAC",
    "audio_sample_rate_hz": 16000,
    "audio_channels": 1,
    "duration_seconds": 60,
    "metadata_removed": true,
    "reference_encoder": "FFmpeg 9.0.1 with libx264, single-threaded bit-exact flags",
    "reproducibility_note": "The canonical command reproduced an identical SHA-256 in a clean second encode on the reference machine. Different FFmpeg or libx264 builds may encode different bytes and must not silently replace the pinned artifacts."
  },
  "split_policy": {
    "development": "May be inspected while developing deterministic measurements and quality guardrails.",
    "model_output_holdout": "Selected and manually annotated before any PresentCoach model output was run. Do not inspect model output or tune against these clips until all development decisions are frozen.",
    "grouping": "split_group_id binds every excerpt from the same original Commons recording to one split."
  },
  "annotation_contract": {
    "method": "single_curator_manual_coarse_intervals",
    "curator_count": 1,
    "annotation_date": "2026-08-20",
    "manual_sampling_interval_seconds": 5,
    "boundary_refinement_interval_seconds": 1,
    "boundary_uncertainty_seconds": 2.5,
    "frame_exhaustive": false,
    "independently_adjudicated": false,
    "accuracy_claim_allowed": false,
    "single_trackable": "Exactly one clearly visible face in a reasonably frontal or profile view and at sufficient apparent size for landmark geometry.",
    "no_face": "No human face is visible in the manually inspected interval.",
    "multiple_faces": "More than one human face is visibly present; a single tracked presenter must not be assumed.",
    "occluded_or_tiny": "A face is visible but is too small, dark, or obscured for stable landmark geometry.",
    "uncertain": "The curator could not defensibly assign another state; excluded from scoring.",
    "motion": "A coarse visible-motion category assigned only when face_state is single_trackable; otherwise unknown.",
    "gaze_truth": "Always unknown in this corpus. Stage-camera direction is not eye-contact ground truth.",
    "limitations": "Intervals are non-frame-exhaustive single-curator observations with approximate boundaries and cannot support independently adjudicated accuracy claims.",
    "pre_release_curator_qa": {
      "completed_date": "2026-08-20",
      "status": "visual_only_pass_after_corrections",
      "canonical_excerpts_reviewed": 10,
      "method": "Every canonical excerpt was reviewed in a two-second contact grid; every production cut or ambiguous state boundary was rechecked at one-second resolution and selected faces were inspected at native-pixel crops.",
      "model_or_evaluator_output_viewed": false,
      "results_generated_from_draft_annotations": "invalidated",
      "corrections": [
        "David Roberts: no state correction; all frames retained as single_trackable.",
        "Jack Andraka: production-cut boundaries refined to 16, 24, 32, 51, and 56 seconds.",
        "Richard Gill: audience cuts and returns refined to 9, 18, 46, 50, and 56 seconds; final wide-stage view remains occluded_or_tiny.",
        "Leslie Cannold: the incorrect 25-40 second occluded_or_tiny label was removed; 9-60 seconds is single_trackable after an 8-9 second dissolve.",
        "You Should Speak: corrected from occluded_or_tiny to single_trackable for the full excerpt.",
        "Constance Adams: production-cut boundaries refined to 4, 31, and 49 seconds.",
        "Simon Stone: corrected to occluded_or_tiny at 0-51 and 57-60 seconds, with the clearly lit face at 51-57 seconds labeled single_trackable.",
        "Sujiwo Tejo: no state correction; hat brim and hair visibly obstruct the eye region throughout, so occluded_or_tiny remains.",
        "Find link lightning talk: corrected from occluded_or_tiny to single_trackable throughout; motion changes from mixed to translate at 52 seconds.",
        "Martha Forsyth: slide and dissolve boundaries refined to 8, 10, 41, and 44 seconds."
      ]
    }
  },
  "power_policy": {
    "minimum_trackable_frames": 15,
    "minimum_nontrackable_frames": 15,
    "minimum_multi_face_frames": 15,
    "minimum_trackable_seconds": 10.0,
    "minimum_reacquisition_events": 3,
    "minimum_sampling_coverage_ratio": 0.8
  },
  "scoring_policy": {
    "scope": "one_global_policy_for_development_and_model_output_holdout",
    "thresholds_frozen_before_model_output_holdout": true,
    "aggregation": "Pool labeled observations and reacquisition events within each dataset_role while also reporting every clip; never tune or set thresholds per clip.",
    "uncertain_and_unlabeled_intervals": "excluded",
    "underpowered_metric_behavior": "Return null with a reason and fail the overall gate closed.",
    "gaze_metric_behavior": "Do not score gaze because the corpus has no independently labeled contact/away truth.",
    "required_metrics": [
      "trackable_coverage",
      "false_valid_rate",
      "multi_face_abstention",
      "dropouts_per_annotated_minute",
      "reacquisition_success_rate",
      "max_reacquisition_latency_seconds"
    ],
    "acceptance_thresholds": {
      "trackable_coverage_min": 0.75,
      "false_valid_rate_max": 0.1,
      "multi_face_abstention_min": 0.9,
      "dropouts_per_annotated_minute_max": 6.0,
      "reacquisition_success_rate_min": 0.8,
      "max_reacquisition_latency_seconds_max": 2.0
    },
    "claim_boundary": "These are pre-registered engineering gates for this ten-clip scenario corpus, not population accuracy, generalization, identity recognition, or model-training evidence."
  },
